  @ManyToOne(() => Employee)
  @JoinColumn({ name: 'sales_staff_id' })
  sales_staff: Employee;

  @Column({ type: 'decimal', precision: 15, scale: 2, default: 0 })
  sub_total: number;

  @Column({ type: 'decimal', precision: 15, scale: 2, default: 0 })
  discount_amount: number;

  @Column({ type: 'decimal', precision: 15, scale: 2, default: 0 })
  tax_amount: number;

  @Column({ type: 'decimal', precision: 15, scale: 2, default: 0 })
  shipping_fee: number;

  @Column({ type: 'decimal', precision: 15, scale: 2, default: 0 })
  total_amount: number;

  @Column({ type: 'enum', enum: PaymentMethod, nullable: true })
